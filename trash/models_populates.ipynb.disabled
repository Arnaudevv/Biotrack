   "source": [
    "# ---------------------------\n",
    "#  TRABAJADORES\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "    staff_to_add = [\n",
    "        {\"code\": \"S001\", \"name\": \"Elena\",   \"lastname\": \"Torres\",   \"role\": \"researcher\",    \"active\": True},\n",
    "        {\"code\": \"S002\", \"name\": \"Pedro\",   \"lastname\": \"Sánchez\",  \"role\": \"analyst\",       \"active\": True},\n",
    "        {\"code\": \"S003\", \"name\": \"Laura\",   \"lastname\": \"Jiménez\",  \"role\": \"technician\",    \"active\": True},\n",
    "        {\"code\": \"S004\", \"name\": \"Roberto\", \"lastname\": \"Morales\",  \"role\": \"manager\",       \"active\": True},\n",
    "        {\"code\": \"S005\", \"name\": \"Sofía\",   \"lastname\": \"Navarro\",  \"role\": \"administrator\", \"active\": False},\n",
    "    ]\n",
    "\n",
    "    existing = {s.code: s for s in session.query(Staff).all()}\n",
    "\n",
    "    for data in staff_to_add:\n",
    "        if data[\"code\"] not in existing:\n",
    "            staff = Staff(**data)\n",
    "            session.add(staff)\n",
    "            existing[data[\"code\"]] = staff\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Trabajadores en BD: {session.query(Staff).count()}\")"
   ]
  },
