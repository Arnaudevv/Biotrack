   "cell_type": "markdown",
   "id": "protocol-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 6️⃣ Protocolos (`Protocol`)\n",
    "Depende de `Staff` (FK `reviewed_by_id` → `staff.id`, nullable).\n",
    "Primero recuperamos los IDs de los trabajadores ya insertados."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "protocol-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  PROTOCOLOS\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "\n",
    "    # Recuperamos el personal existente indexado por 'code' para poder\n",
    "    # referenciarlos por su ID en la FK reviewed_by_id\n",
    "    staff_map = {s.code: s for s in session.query(Staff).all()}\n",
    "\n",
    "    protocols_to_add = [\n",
    "        {\n",
    "            \"code\": \"PROT001\",\n",
    "            \"name\": \"Extracción de ADN por columna\",\n",
    "            \"description\": \"Protocolo estándar para extracción de ADN genómico usando columnas de sílice.\",\n",
    "            \"creation_date\": date(2022, 6, 1),\n",
    "            \"last_review_date\": date(2023, 1, 20),\n",
    "            \"reviewed_by_id\": staff_map[\"S001\"].id  # Revisado por Elena Torres (researcher)\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"PROT002\",\n",
    "            \"name\": \"PCR cuantitativa en tiempo real\",\n",
    "            \"description\": \"Amplificación y cuantificación de fragmentos de ADN/ARN mediante qPCR.\",\n",
    "            \"creation_date\": date(2022, 9, 15),\n",
    "            \"last_review_date\": date(2023, 3, 10),\n",
    "            \"reviewed_by_id\": staff_map[\"S002\"].id  # Revisado por Pedro Sánchez (analyst)\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"PROT003\",\n",
    "            \"name\": \"Centrifugación diferencial\",\n",
    "            \"description\": \"Separación de componentes celulares mediante centrifugación escalonada.\",\n",
    "            \"creation_date\": date(2023, 2, 5),\n",
    "            \"last_review_date\": None,   # Aún no revisado\n",
    "            \"reviewed_by_id\": None       # reviewed_by_id es nullable en el modelo\n",
    "        },\n",
    "    ]\n",
    "\n",
    "    existing = {p.code: p for p in session.query(Protocol).all()}\n",
    "\n",
    "    for data in protocols_to_add:\n",
    "        if data[\"code\"] not in existing:\n",
    "            protocol = Protocol(**data)\n",
    "            session.add(protocol)\n",
    "            existing[data[\"code\"]] = protocol\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Protocolos en BD: {session.query(Protocol).count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "sample-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 7️⃣ Muestras (`Sample`)\n",
    "Depende de `Patient`, `SampleType` y `Container`.\n",
    "El campo `status` es un ENUM: `pending`, `in_process`, `analyzed`, `rejected`, `archived`.\n",
    "El campo `volume` debe ser > 0 (hay un `CheckConstraint` en el modelo)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "sample-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  MUESTRAS\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "\n",
    "    # Recuperamos las entidades relacionadas indexadas por su campo único\n",
    "    # para poder referenciarlas por ID al crear las muestras\n",
    "    patient_map    = {p.code: p  for p in session.query(Patient).all()}\n",
    "    type_map       = {st.type_name: st for st in session.query(SampleType).all()}\n",
    "    container_map  = {c.code: c  for c in session.query(Container).all()}\n",
    "\n",
    "    samples_to_add = [\n",
    "        {\n",
    "            \"code\": \"MU001\",\n",
    "            \"volume\": 5.0,               # En mL; debe ser > 0\n",
    "            \"extraction_date\": date(2023, 6, 1),\n",
    "            \"status\": \"analyzed\",\n",
    "            \"id_patient\":     patient_map[\"P001\"].id,\n",
    "            \"id_sample_type\": type_map[\"Sangre\"].id,\n",
    "            \"id_container\":   container_map[\"C001\"].id\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"MU002\",\n",
    "            \"volume\": 10.0,\n",
    "            \"extraction_date\": date(2023, 6, 5),\n",
    "            \"status\": \"pending\",\n",
    "            \"id_patient\":     patient_map[\"P002\"].id,\n",
    "            \"id_sample_type\": type_map[\"Orina\"].id,\n",
    "            \"id_container\":   container_map[\"C004\"].id\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"MU003\",\n",
    "            \"volume\": 2.5,\n",
    "            \"extraction_date\": date(2023, 6, 10),\n",
    "            \"status\": \"in_process\",\n",
    "            \"id_patient\":     patient_map[\"P003\"].id,\n",
    "            \"id_sample_type\": type_map[\"Tejido\"].id,\n",
    "            \"id_container\":   container_map[\"C003\"].id\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"MU004\",\n",
    "            \"volume\": 7.5,\n",
    "            \"extraction_date\": date(2023, 6, 15),\n",
    "            \"status\": \"rejected\",\n",
    "            \"id_patient\":     patient_map[\"P004\"].id,\n",
    "            \"id_sample_type\": type_map[\"Plasma\"].id,\n",
    "            \"id_container\":   container_map[\"C002\"].id\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"MU005\",\n",
    "            \"volume\": 3.0,\n",
    "            \"extraction_date\": date(2023, 6, 20),\n",
    "            \"status\": \"archived\",\n",
    "            \"id_patient\":     patient_map[\"P001\"].id,  # El paciente P001 tiene dos muestras\n",
    "            \"id_sample_type\": type_map[\"Saliva\"].id,\n",
    "            \"id_container\":   container_map[\"C005\"].id\n",
    "        },\n",
    "        {\n",
    "            \"code\": \"MU006\",\n",
    "            \"volume\": 6.0,\n",
    "            \"extraction_date\": date(2023, 7, 1),\n",
    "            \"status\": \"analyzed\",\n",
    "            \"id_patient\":     patient_map[\"P002\"].id,\n",
    "            \"id_sample_type\": type_map[\"Sangre\"].id,\n",
    "            \"id_container\":   container_map[\"C001\"].id\n",
    "        },\n",
    "    ]\n",
    "\n",
    "    existing = {s.code: s for s in session.query(Sample).all()}\n",
    "\n",
    "    for data in samples_to_add:\n",
    "        if data[\"code\"] not in existing:\n",
    "            sample = Sample(**data)\n",
    "            session.add(sample)\n",
    "            existing[data[\"code\"]] = sample\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Muestras en BD: {session.query(Sample).count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "logtemp-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 8️⃣ Registros de temperatura (`LogTemperature`)\n",
    "Depende de `Sample` (FK `id_sample`). Una muestra puede tener múltiples registros.\n",
    "Como esta tabla no tiene un campo único natural, comprobamos duplicados con un conjunto de tuplas `(id_sample, reading_date)`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "logtemp-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  REGISTROS DE TEMPERATURA\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "\n",
    "    sample_map = {s.code: s for s in session.query(Sample).all()}\n",
    "\n",
    "    logs_to_add = [\n",
    "        {\"id_sample\": sample_map[\"MU001\"].id, \"reading_date\": datetime(2023, 6,  1, 8,  0), \"temperature\": -80.0},\n",
    "        {\"id_sample\": sample_map[\"MU001\"].id, \"reading_date\": datetime(2023, 6,  2, 8,  0), \"temperature\": -79.5},\n",
    "        {\"id_sample\": sample_map[\"MU002\"].id, \"reading_date\": datetime(2023, 6,  5, 9,  0), \"temperature\":   4.0},\n",
    "        {\"id_sample\": sample_map[\"MU003\"].id, \"reading_date\": datetime(2023, 6, 10, 10, 0), \"temperature\": -20.0},\n",
    "        {\"id_sample\": sample_map[\"MU003\"].id, \"reading_date\": datetime(2023, 6, 11, 10, 0), \"temperature\": -20.2},\n",
    "        {\"id_sample\": sample_map[\"MU004\"].id, \"reading_date\": datetime(2023, 6, 15, 11, 0), \"temperature\":   4.5},\n",
    "        {\"id_sample\": sample_map[\"MU005\"].id, \"reading_date\": datetime(2023, 6, 20, 8,  0), \"temperature\": -80.0},\n",
    "        {\"id_sample\": sample_map[\"MU006\"].id, \"reading_date\": datetime(2023, 7,  1, 8,  0), \"temperature\": -80.0},\n",
    "    ]\n",
    "\n",
    "    # Como no hay campo único natural, usamos la combinación (id_sample, reading_date)\n",
    "    existing = {\n",
    "        (lt.id_sample, lt.reading_date)\n",
    "        for lt in session.query(LogTemperature).all()\n",
    "    }\n",
    "\n",
    "    for data in logs_to_add:\n",
    "        key = (data[\"id_sample\"], data[\"reading_date\"])\n",
    "        if key not in existing:\n",
    "            log = LogTemperature(**data)\n",
    "            session.add(log)\n",
    "            existing.add(key)\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Registros de temperatura en BD: {session.query(LogTemperature).count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "qc-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 9️⃣ Control de calidad (`QualityControl`)\n",
    "Depende de `Sample`. Relación **1:1** → cada muestra tiene como máximo un control de calidad (`unique=True` en `id_sample`).\n",
    "El campo `result` es un ENUM: `approved`, `rejected`, `pending_review`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "qc-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  CONTROL DE CALIDAD\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "\n",
    "    sample_map = {s.code: s for s in session.query(Sample).all()}\n",
    "\n",
    "    qcs_to_add = [\n",
    "        # MU001 → analizada y aprobada\n",
    "        {\"id_sample\": sample_map[\"MU001\"].id, \"purity\": 95.50, \"concentration\": 120.0000, \"result\": \"approved\"},\n",
    "        # MU002 → pendiente de revisión; la pureza aún no se conoce\n",
    "        {\"id_sample\": sample_map[\"MU002\"].id, \"purity\": None,  \"concentration\": None,     \"result\": \"pending_review\"},\n",
    "        # MU003 → en proceso, datos parciales\n",
    "        {\"id_sample\": sample_map[\"MU003\"].id, \"purity\": 78.20, \"concentration\":  55.1234, \"result\": \"pending_review\"},\n",
    "        # MU004 → rechazada por baja pureza\n",
    "        {\"id_sample\": sample_map[\"MU004\"].id, \"purity\": 40.00, \"concentration\":  10.0000, \"result\": \"rejected\"},\n",
    "        # MU005 → aprobada\n",
    "        {\"id_sample\": sample_map[\"MU005\"].id, \"purity\": 99.10, \"concentration\": 200.0000, \"result\": \"approved\"},\n",
    "        # MU006 → aprobada\n",
    "        {\"id_sample\": sample_map[\"MU006\"].id, \"purity\": 91.30, \"concentration\": 150.5000, \"result\": \"approved\"},\n",
    "    ]\n",
    "\n",
    "    # La unicidad está garantizada por id_sample (unique=True en el modelo),\n",
    "    # así que indexamos por id_sample para detectar duplicados\n",
    "    existing = {qc.id_sample for qc in session.query(QualityControl).all()}\n",
    "\n",
    "    for data in qcs_to_add:\n",
    "        if data[\"id_sample\"] not in existing:\n",
    "            qc = QualityControl(**data)\n",
    "            session.add(qc)\n",
    "            existing.add(data[\"id_sample\"])\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Controles de calidad en BD: {session.query(QualityControl).count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "rps-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 🔟 Muestras en proyectos (`ResearchProjectSamples`)\n",
    "Tabla N:M con atributos entre `Sample` y `ResearchProject`.\n",
    "La PK compuesta `(id_sample, id_project)` garantiza que una muestra no se asigne dos veces al mismo proyecto."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "rps-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  MUESTRAS EN PROYECTOS\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "\n",
    "    sample_map  = {s.code: s  for s in session.query(Sample).all()}\n",
    "    project_map = {p.project_name: p for p in session.query(ResearchProject).all()}\n",
    "\n",
    "    rps_to_add = [\n",
    "        # Proyecto Alpha: trabaja con MU001, MU003 y MU005\n",
    "        {\"id_sample\": sample_map[\"MU001\"].id, \"id_project\": project_map[\"Estudio Oncológico Alpha\"].id,      \"sample_assignment_date\": date(2023, 6, 2)},\n",
    "        {\"id_sample\": sample_map[\"MU003\"].id, \"id_project\": project_map[\"Estudio Oncológico Alpha\"].id,      \"sample_assignment_date\": date(2023, 6, 12)},\n",
    "        {\"id_sample\": sample_map[\"MU005\"].id, \"id_project\": project_map[\"Estudio Oncológico Alpha\"].id,      \"sample_assignment_date\": date(2023, 6, 22)},\n",
    "        # Proyecto Beta: trabaja con MU002 y MU004\n",
    "        {\"id_sample\": sample_map[\"MU002\"].id, \"id_project\": project_map[\"Genómica Cardiovascular Beta\"].id,  \"sample_assignment_date\": date(2023, 6, 6)},\n",
    "        {\"id_sample\": sample_map[\"MU004\"].id, \"id_project\": project_map[\"Genómica Cardiovascular Beta\"].id,  \"sample_assignment_date\": date(2023, 6, 16)},\n",
    "        # Proyecto Gamma: trabaja con MU006 (y también comparte MU001 con Alpha)\n",
    "        {\"id_sample\": sample_map[\"MU006\"].id, \"id_project\": project_map[\"Microbioma Digestivo Gamma\"].id,    \"sample_assignment_date\": date(2023, 7, 2)},\n",
    "        {\"id_sample\": sample_map[\"MU001\"].id, \"id_project\": project_map[\"Microbioma Digestivo Gamma\"].id,    \"sample_assignment_date\": date(2023, 7, 3)},\n",
    "    ]\n",
    "\n",
    "    # La PK compuesta (id_sample, id_project) es la clave para evitar duplicados\n",
    "    existing = {\n",
    "        (rps.id_sample, rps.id_project)\n",
    "        for rps in session.query(ResearchProjectSamples).all()\n",
    "    }\n",
    "\n",
    "    for data in rps_to_add:\n",
    "        key = (data[\"id_sample\"], data[\"id_project\"])\n",
    "        if key not in existing:\n",
    "            rps = ResearchProjectSamples(**data)\n",
    "            session.add(rps)\n",
    "            existing.add(key)\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Asignaciones muestra-proyecto en BD: {session.query(ResearchProjectSamples).count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "pt-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 1️⃣1️⃣ Equipo de proyecto (`ProjectTeam`)\n",
    "Tabla N:M entre `Staff` y `ResearchProject`. Añade el atributo `role` a la relación.\n",
    "El `role` aquí es distinto al `role` de `Staff`: indica el papel del trabajador **dentro del proyecto**.\n",
    "ENUM: `principal_investigator`, `co_investigator`, `analyst`, `technician`, `assistant`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pt-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  EQUIPO DE PROYECTO\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "\n",
    "    staff_map   = {s.code: s for s in session.query(Staff).all()}\n",
    "    project_map = {p.project_name: p for p in session.query(ResearchProject).all()}\n",
    "\n",
    "    pt_to_add = [\n",
    "        # Proyecto Alpha\n",
    "        {\"id_project\": project_map[\"Estudio Oncológico Alpha\"].id,     \"id_staff\": staff_map[\"S001\"].id, \"role\": \"principal_investigator\"},\n",
    "        {\"id_project\": project_map[\"Estudio Oncológico Alpha\"].id,     \"id_staff\": staff_map[\"S002\"].id, \"role\": \"analyst\"},\n",
    "        {\"id_project\": project_map[\"Estudio Oncológico Alpha\"].id,     \"id_staff\": staff_map[\"S003\"].id, \"role\": \"technician\"},\n",
    "        # Proyecto Beta\n",
    "        {\"id_project\": project_map[\"Genómica Cardiovascular Beta\"].id, \"id_staff\": staff_map[\"S001\"].id, \"role\": \"co_investigator\"},\n",
    "        {\"id_project\": project_map[\"Genómica Cardiovascular Beta\"].id, \"id_staff\": staff_map[\"S004\"].id, \"role\": \"principal_investigator\"},\n",
    "        {\"id_project\": project_map[\"Genómica Cardiovascular Beta\"].id, \"id_staff\": staff_map[\"S002\"].id, \"role\": \"assistant\"},\n",
    "        # Proyecto Gamma\n",
    "        {\"id_project\": project_map[\"Microbioma Digestivo Gamma\"].id,   \"id_staff\": staff_map[\"S004\"].id, \"role\": \"co_investigator\"},\n",
    "        {\"id_project\": project_map[\"Microbioma Digestivo Gamma\"].id,   \"id_staff\": staff_map[\"S003\"].id, \"role\": \"technician\"},\n",
    "    ]\n",
    "\n",
    "    # La PK compuesta (id_project, id_staff) garantiza que un trabajador\n",
    "    # no aparezca dos veces en el mismo proyecto\n",
    "    existing = {\n",
    "        (pt.id_project, pt.id_staff)\n",
    "        for pt in session.query(ProjectTeam).all()\n",
    "    }\n",
    "\n",
    "    for data in pt_to_add:\n",
    "        key = (data[\"id_project\"], data[\"id_staff\"])\n",
    "        if key not in existing:\n",
    "            pt = ProjectTeam(**data)\n",
    "            session.add(pt)\n",
    "            existing.add(key)\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Miembros de equipo en BD: {session.query(ProjectTeam).count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "sp-md",
   "metadata": {},
   "source": [
    "---\n",
    "## 1️⃣2️⃣ Protocolos por muestra (`sample_protocol`)\n",
    "Tabla N:M **sin clase propia** (solo FKs, definida con `Table` en el modelo).\n",
    "La forma más sencilla de gestionar esta relación es a través del atributo `protocols` de `Sample`\n",
    "o `samples` de `Protocol`, aprovechando que SQLAlchemy gestiona la tabla intermedia automáticamente."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "sp-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  PROTOCOLOS POR MUESTRA\n",
    "# ---------------------------\n",
    "# Al ser una tabla N:M sin clase propia, usamos las relaciones de SQLAlchemy\n",
    "# directamente: accedemos a sample.protocols y añadimos protocolos si no están ya\n",
    "with Session() as session:\n",
    "\n",
    "    sample_map   = {s.code: s   for s in session.query(Sample).all()}\n",
    "    protocol_map = {p.code: p   for p in session.query(Protocol).all()}\n",
    "\n",
    "    # Definimos qué protocolos aplican a cada muestra\n",
    "    # Formato: (código_muestra, [lista de códigos de protocolo])\n",
    "    assignments = [\n",
    "        (\"MU001\", [\"PROT001\", \"PROT002\"]),  # Sangre analizada → extracción de ADN + qPCR\n",
    "        (\"MU002\", [\"PROT003\"]),              # Orina → solo centrifugación\n",
    "        (\"MU003\", [\"PROT001\", \"PROT003\"]),  # Tejido → extracción + centrifugación\n",
    "        (\"MU004\", [\"PROT002\"]),              # Plasma → qPCR\n",
    "        (\"MU005\", [\"PROT001\"]),              # Saliva → extracción de ADN\n",
    "        (\"MU006\", [\"PROT001\", \"PROT002\"]),  # Sangre analizada → extracción + qPCR\n",
    "    ]\n",
    "\n",
    "    for sample_code, protocol_codes in assignments:\n",
    "        sample = sample_map[sample_code]\n",
    "\n",
    "        # Creamos un set con los IDs de protocolos ya asignados a esta muestra\n",
    "        # para no duplicar la relación (SQLAlchemy lo protege con la PK compuesta,\n",
    "        # pero es buena práctica comprobarlo antes)\n",
    "        existing_protocol_ids = {p.id for p in sample.protocols}\n",
    "\n",
    "        for prot_code in protocol_codes:\n",
    "            protocol = protocol_map[prot_code]\n",
    "            if protocol.id not in existing_protocol_ids:\n",
    "                sample.protocols.append(protocol)  # SQLAlchemy inserta la fila en sample_protocol\n",
    "                existing_protocol_ids.add(protocol.id)\n",
    "\n",
    "    session.commit()\n",
    "    print(\"✅ Relaciones muestra-protocolo insertadas correctamente\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "verify-md",
   "metadata": {},
   "source": [
    "---\n",
    "## ✅ Verificación final\n",
    "Comprobamos el recuento de registros en todas las tablas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "verify-cell",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------------------\n",
    "#  RESUMEN FINAL\n",
    "# ---------------------------\n",
    "with Session() as session:\n",
    "    tablas = [\n",
    "        (\"Patient\",                  Patient),\n",
    "        (\"Staff\",                    Staff),\n",
    "        (\"SampleType\",               SampleType),\n",
    "        (\"Container\",                Container),\n",
    "        (\"ResearchProject\",          ResearchProject),\n",
    "        (\"Protocol\",                 Protocol),\n",
    "        (\"Sample\",                   Sample),\n",
    "        (\"LogTemperature\",           LogTemperature),\n",
    "        (\"QualityControl\",           QualityControl),\n",
    "        (\"ResearchProjectSamples\",   ResearchProjectSamples),\n",
    "        (\"ProjectTeam\",              ProjectTeam),\n",
    "    ]\n",
    "\n",
    "    print(f\"{'Tabla':<30} {'Registros':>10}\")\n",
    "    print(\"-\" * 42)\n",
    "    for nombre, modelo in tablas:\n",
    "        count = session.query(modelo).count()\n",
    "        print(f\"{nombre:<30} {count:>10}\")"
   ]
  }
 ],
