     "output_type": "error",
     "traceback": [
      "\u001b[31m---------------------------------------------------------------------------\u001b[39m",
      "\u001b[31mNameError\u001b[39m                                 Traceback (most recent call last)",
      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[14]\u001b[39m\u001b[32m, line 6\u001b[39m\n\u001b[32m      1\u001b[39m \u001b[38;5;66;03m# ---------------------------\u001b[39;00m\n\u001b[32m      2\u001b[39m \u001b[38;5;66;03m#  PACIENTES\u001b[39;00m\n\u001b[32m      3\u001b[39m \u001b[38;5;66;03m# ---------------------------\u001b[39;00m\n\u001b[32m      4\u001b[39m \u001b[38;5;66;03m# Los nombres de los campos deben coincidir EXACTAMENTE con los atributos\u001b[39;00m\n\u001b[32m      5\u001b[39m \u001b[38;5;66;03m# definidos en la clase Patient de models.py\u001b[39;00m\n\u001b[32m----> \u001b[39m\u001b[32m6\u001b[39m \u001b[38;5;28;01mwith\u001b[39;00m \u001b[43mSession\u001b[49m() \u001b[38;5;28;01mas\u001b[39;00m session:\n\u001b[32m      7\u001b[39m     patients_to_add = [\n\u001b[32m      8\u001b[39m         {\u001b[33m\"\u001b[39m\u001b[33mcode\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mP001\u001b[39m\u001b[33m\"\u001b[39m, \u001b[33m\"\u001b[39m\u001b[33mname\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mJuan\u001b[39m\u001b[33m\"\u001b[39m,   \u001b[33m\"\u001b[39m\u001b[33mlastname\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mGarcía\u001b[39m\u001b[33m\"\u001b[39m,    \u001b[33m\"\u001b[39m\u001b[33mbirth_date\u001b[39m\u001b[33m\"\u001b[39m: date(\u001b[32m1985\u001b[39m,  \u001b[32m5\u001b[39m, \u001b[32m20\u001b[39m), \u001b[33m\"\u001b[39m\u001b[33mactive\u001b[39m\u001b[33m\"\u001b[39m: \u001b[38;5;28;01mTrue\u001b[39;00m,  \u001b[33m\"\u001b[39m\u001b[33mregistration_date\u001b[39m\u001b[33m\"\u001b[39m: datetime(\u001b[32m2023\u001b[39m, \u001b[32m1\u001b[39m, \u001b[32m10\u001b[39m)},\n\u001b[32m      9\u001b[39m         {\u001b[33m\"\u001b[39m\u001b[33mcode\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mP002\u001b[39m\u001b[33m\"\u001b[39m, \u001b[33m\"\u001b[39m\u001b[33mname\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mMaría\u001b[39m\u001b[33m\"\u001b[39m,  \u001b[33m\"\u001b[39m\u001b[33mlastname\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mLópez\u001b[39m\u001b[33m\"\u001b[39m,     \u001b[33m\"\u001b[39m\u001b[33mbirth_date\u001b[39m\u001b[33m\"\u001b[39m: date(\u001b[32m1990\u001b[39m,  \u001b[32m7\u001b[39m, \u001b[32m15\u001b[39m), \u001b[33m\"\u001b[39m\u001b[33mactive\u001b[39m\u001b[33m\"\u001b[39m: \u001b[38;5;28;01mTrue\u001b[39;00m,  \u001b[33m\"\u001b[39m\u001b[33mregistration_date\u001b[39m\u001b[33m\"\u001b[39m: datetime(\u001b[32m2023\u001b[39m, \u001b[32m2\u001b[39m, \u001b[32m12\u001b[39m)},\n\u001b[32m   (...)\u001b[39m\u001b[32m     12\u001b[39m         {\u001b[33m\"\u001b[39m\u001b[33mcode\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mP005\u001b[39m\u001b[33m\"\u001b[39m, \u001b[33m\"\u001b[39m\u001b[33mname\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mLuis\u001b[39m\u001b[33m\"\u001b[39m,   \u001b[33m\"\u001b[39m\u001b[33mlastname\u001b[39m\u001b[33m\"\u001b[39m: \u001b[33m\"\u001b[39m\u001b[33mRodríguez\u001b[39m\u001b[33m\"\u001b[39m, \u001b[33m\"\u001b[39m\u001b[33mbirth_date\u001b[39m\u001b[33m\"\u001b[39m: date(\u001b[32m1982\u001b[39m,  \u001b[32m1\u001b[39m, \u001b[32m22\u001b[39m), \u001b[33m\"\u001b[39m\u001b[33mactive\u001b[39m\u001b[33m\"\u001b[39m: \u001b[38;5;28;01mFalse\u001b[39;00m, \u001b[33m\"\u001b[39m\u001b[33mregistration_date\u001b[39m\u001b[33m\"\u001b[39m: datetime(\u001b[32m2023\u001b[39m, \u001b[32m5\u001b[39m,  \u001b[32m2\u001b[39m)},\n\u001b[32m     13\u001b[39m     ]\n\u001b[32m     15\u001b[39m     \u001b[38;5;66;03m# Obtenemos los pacientes ya existentes indexados por 'code' (campo único)\u001b[39;00m\n\u001b[32m     16\u001b[39m     \u001b[38;5;66;03m# Así evitamos duplicados y solo buscamos en memoria, no en la DB en cada iteración\u001b[39;00m\n",
      "\u001b[31mNameError\u001b[39m: name 'Session' is not defined"
     ]
    }
   ],
   "source": [
    "# ---------------------------\n",
    "#  PACIENTES\n",
    "# ---------------------------\n",
    "# Los nombres de los campos deben coincidir EXACTAMENTE con los atributos\n",
    "# definidos en la clase Patient de models.py\n",
    "with Session() as session:\n",
    "    patients_to_add = [\n",
    "        {\"code\": \"P001\", \"name\": \"Juan\",   \"lastname\": \"García\",    \"birth_date\": date(1985,  5, 20), \"active\": True,  \"registration_date\": datetime(2023, 1, 10)},\n",
    "        {\"code\": \"P002\", \"name\": \"María\",  \"lastname\": \"López\",     \"birth_date\": date(1990,  7, 15), \"active\": True,  \"registration_date\": datetime(2023, 2, 12)},\n",
    "        {\"code\": \"P003\", \"name\": \"Carlos\", \"lastname\": \"Martínez\",  \"birth_date\": date(1978,  3,  9), \"active\": True,  \"registration_date\": datetime(2023, 3,  5)},\n",
    "        {\"code\": \"P004\", \"name\": \"Ana\",    \"lastname\": \"Fernández\", \"birth_date\": date(1995, 11, 30), \"active\": True,  \"registration_date\": datetime(2023, 4, 18)},\n",
    "        {\"code\": \"P005\", \"name\": \"Luis\",   \"lastname\": \"Rodríguez\", \"birth_date\": date(1982,  1, 22), \"active\": False, \"registration_date\": datetime(2023, 5,  2)},\n",
    "    ]\n",
    "\n",
    "    # Obtenemos los pacientes ya existentes indexados por 'code' (campo único)\n",
    "    # Así evitamos duplicados y solo buscamos en memoria, no en la DB en cada iteración\n",
    "    existing = {p.code: p for p in session.query(Patient).all()}\n",
    "\n",
    "    for data in patients_to_add:\n",
    "        if data[\"code\"] not in existing:\n",
    "            patient = Patient(**data)  # Desempaquetamos el dict directamente\n",
    "            session.add(patient)\n",
    "            existing[data[\"code\"]] = patient  # Lo añadimos al dict local para evitar duplicados en la misma ejecución\n",
    "\n",
    "    session.commit()\n",
    "    print(f\"✅ Pacientes en BD: {session.query(Patient).count()}\")"
   ]
  },
  {
