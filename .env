# =============================================================================
# ENVIRONMENT VARIABLES & SYSTEM SECRETS
# =============================================================================
# This file stores sensitive configuration and environment-specific variables.
# ⚠️ SECURITY WARNING: Never commit the actual .env file to version control.
# =============================================================================

# ACTIVE ENVIRONMENT SELECTION
# Options: development | test | production
ENVIRONMENT=development

# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For local environments, we only store the FILENAME. 
# The full path is constructed dynamically by the application.
DB_FILENAME_DEVELOPMENT=biotrack.db
DB_FILENAME_TEST=biotrack_test.db

# For production, we use a full Connection URI (PostgreSQL).
DB_URL_PRODUCTION=postgresql://admin:admin123@5432/biotrack

# =============================================================================
# INFRASTRUCTURE OVERVIEW
# =============================================================================
#
# [ DEVELOPMENT ]
# Location: Local Machine (SQLite)
# Purpose: Feature building and sandbox experimentation.
#
# [ TEST / STAGING ]
# Location: Local/CI-CD Environment (Temporary DB)
# Purpose: Regression testing and pre-deployment validation.
#
# [ PRODUCTION ] 
# Location: Google Cloud Platform (GCP) Virtual Machine
# Purpose: Live user environment. Requires maximum stability and security.
# =============================================================================